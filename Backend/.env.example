# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/doctor_appointment_db

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email Service (Nodemailer with Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Cloudinary (Profile Image & Report Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI API Key (Triage, Voice Scribe, Safety Check, Pre-Consult Brief)
GEMINI_API_KEY=your_gemini_api_key_here
